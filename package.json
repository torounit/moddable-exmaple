{
  "name": "moddable-example",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "type": "module",
  "description": "Moddable SDK + TypeScript technical-validation app for M5Stack CoreS3",
  "scripts": {
    "build": "xs-dev build",
    "start": "xs-dev run",
    "deploy": "xs-dev run --device esp32/m5stack_cores3",
    "prebuild": "tsc",
    "prestart": "tsc",
    "predeploy": "tsc"
  },
  "devDependencies": {
    "@moddable/typings": "^8.3.0",
    "typescript": "^6.0.3"
  },
  "moddable": {
    "manifest": {
      "build": {
        "MODULES": "$(MODDABLE)/modules"
      },
      "include": [
        "$(MODDABLE)/examples/manifest_base.json"
      ],
      "resources": {
        "*-alpha": [
          "$(MODDABLE)/examples/assets/fonts/OpenSans-Semibold-28"
        ]
      }
    }
  }
}
