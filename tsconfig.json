{
  "compilerOptions": {
    "incremental": true,
    "lib": [
      "es2022"
    ],
    "outDir": "dist",
    "module": "es2022",
    "sourceMap": true,
    "target": "ES2022",
    "checkJs": true,
    "baseUrl": ".",
    "paths": {
      "*": [
        "*",
        "node_modules/@moddable/typings/*"
      ]
