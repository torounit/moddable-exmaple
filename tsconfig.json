{
	"compilerOptions": {
		"target": "es2022",
		"module": "es2022",
		"moduleResolution": "bundler",
		"lib": ["es2022", "esnext.disposable"],
		"strict": true,
		"noEmit": true,
		"paths": {
			"*": ["./node_modules/@moddable/typings/*"]
		},
		"types": ["./node_modules/@moddable/typings/xs"]
	},
	"include": ["*.ts"]
}
